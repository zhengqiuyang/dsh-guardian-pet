{
  "name": "dsh-guardian-pet",
  "version": "0.1.0",
  "description": "A guardian pet for your DeepSeek Harness agent: it sleeps while all is clear, bristles when something is caught, and writes you a weekly battle report from the trust family's nine channels. Zero LLM calls",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client/index.js"
  },
  "files": [
    "lib",
    "client",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-modules",
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    },
    "manifestVersion": 1
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "test": "npm run build && node test/run-tests.mjs"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "ai-agents",
    "gamification",
    "security"
  ],
  "dependencies": {
    "dsh-trust-panel": "^0.1.1"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.0",
    "@deepseek-ai/schemastery": "^3.18.0",
    "@types/node": "^22.10.2",
    "typescript": "^5.7.3"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zhengqiuyang/dsh-guardian-pet.git"
  }
}
